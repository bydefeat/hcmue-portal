DEFEAT_POSTGRES_PRIMARY_DATABASE_CONNECTION_URL=postgres://postgres:postgres@localhost:5432/hcmue_portal
# Tùy chọn: số kết nối tối đa mỗi instance (mặc định 10), thời gian tối đa một câu truy vấn (mặc định 15000 ms), in câu SQL ra log
DEFEAT_POSTGRES_POOL_MAX=
DEFEAT_POSTGRES_STATEMENT_TIMEOUT_MS=
DEFEAT_DATABASE_LOG_QUERIES=
# Ít nhất 32 ký tự, tạo bằng: openssl rand -base64 32
DEFEAT_BETTER_AUTH_SESSION_SIGNING_SECRET_KEY=
DEFEAT_BETTER_AUTH_PUBLIC_APPLICATION_BASE_URL=http://localhost:3000
# Tùy chọn: các origin khác được phép gọi API xác thực, cách nhau bởi dấu phẩy
DEFEAT_BETTER_AUTH_TRUSTED_ORIGINS=
# Tùy chọn, chỉ dùng cho npm run db:seed
DEFEAT_SEED_ACCOUNT_PASSWORD=
# Gửi email qua Resend (khóa dạng re_...). Bắt buộc khi chạy production; bỏ trống ở máy phát triển thì thư (kể cả mã OTP) chỉ in ra log server.
# Địa chỉ gửi phải thuộc tên miền đã xác minh trên Resend; onboarding@resend.dev chỉ gửi được tới email của chủ tài khoản Resend.
DEFEAT_RESEND_API_KEY=
DEFEAT_MAIL_FROM=
# Tùy chọn: khóa bí mật (ít nhất 32 ký tự) cho bộ hẹn giờ gọi POST /api/cron/<tác vụ> với header Authorization: Bearer <khóa>
DEFEAT_CRON_SECRET=
# Tùy chọn: thư mục lưu tệp tải lên (minh chứng đơn từ, đề thi), mặc định ./storage. Không đặt trong public/.
DEFEAT_STORAGE_DIRECTORY=
# Tùy chọn: header chứa IP thật của người dùng do reverse proxy ghi đè (mặc định x-forwarded-for), dùng cho rate limit đăng nhập và nhật ký.
DEFEAT_TRUSTED_IP_HEADER=
# Tùy chọn: IP hoặc dải CIDR của reverse proxy, cách nhau bởi dấu phẩy. Bỏ trống thì chỉ tin header có đúng một IP.
DEFEAT_TRUSTED_PROXIES=
# Múi giờ của script (seed, test) chạy bằng tsx --env-file; app Next tự đặt trong src/instrumentation.ts.
TZ=Asia/Ho_Chi_Minh
